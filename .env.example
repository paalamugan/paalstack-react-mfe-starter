# Shared MFE remote entry URL (for Module Federation)
VITE_SHARED_REMOTE_URL="http://localhost:9002/assets/remoteEntry.js"

# Base URL for your application's REST API
VITE_API_BASE_URL="https://api.example.com/v1"

# Enable verbose debug logging (true | false)
VITE_DEBUG_MODE=false

# Base public path for the built assets.
# Set to '/<repo-name>/' when deploying to GitHub Pages.
# Leave as '/' for deployments at the domain root.
VITE_BASE_URL="/"
